# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored and must NEVER be committed.

# Full path to your Google service account key file (keep it OUTSIDE the repo).
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your\service-account-key.json

# ID of the Google Drive folder to read (the last part of the folder URL).
DRIVE_FOLDER_ID=your_drive_folder_id

# SQL Server connection (Windows authentication is used, so no password is stored).
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=CurriculumDB
DB_DRIVER=ODBC Driver 17 for SQL Server
